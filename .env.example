# BrowserPilot Configuration Examples

# For Google Gemini (default)
# GOOGLE_API_KEY=your_gemini_api_key_here

# For Ollama (uncomment to use Ollama instead of Gemini)
AI_MODEL_TYPE=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL_NAME=llava:latest

# Optional: Proxy configuration
# SCRAPER_PROXIES=[{"server": "http://proxy1:port", "username": "user", "password": "pass"}]